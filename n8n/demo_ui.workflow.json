    {
      "parameters": {
        "jsCode": "// Build the same request eval/run_baseline.py sends with the Anthropic SDK.\nconst SYSTEM = \"You work in the complaints team of a US consumer finance company. For the complaint you are given, do the whole job in one pass:\\n\\n1. Classify it. Choose the product, then choose one issue from that product's list. Copy both exactly as written below.\\n2. Predict how the company will close it: explanation_only (the company explains but changes nothing), non_monetary_relief (it fixes something, such as correcting a record), or monetary_relief (it refunds or credits money).\\n3. Decide whether a human must review the case before any reply is sent.\\n4. Draft the reply to the consumer. Name any US consumer finance law that applies.\\n\\nComplaint text has personal details replaced with XXXX.\\n\\nPRODUCT: Checking or savings account\\n  - Closing an account\\n  - Managing an account\\n  - Opening an account\\n  - Problem caused by your funds being low\\n  - Problem with a lender or other company charging your account\\nPRODUCT: Credit card\\n  - Advertising and marketing, including promotional offers\\n  - Closing your account\\n  - Credit monitoring or identity theft protection services\\n  - Fees or interest\\n  - Getting a credit card\\n  - Improper use of your report\\n  - Incorrect information on your report\\n  - Other features, terms, or problems\\n  - Problem when making payments\\n  - Problem with a company's investigation into an existing problem\\n  - Problem with a purchase shown on your statement\\n  - Struggling to pay your bill\\n  - Trouble using your card\\nPRODUCT: Credit reporting or other personal consumer reports\\n  - Credit monitoring or identity theft protection services\\n  - Identity theft protection or other monitoring services\\n  - Improper use of your report\\n  - Incorrect information on your report\\n  - Problem with a company's investigation into an existing issue\\n  - Problem with a company's investigation into an existing problem\\n  - Problem with fraud alerts or security freezes\\n  - Unable to get your credit report or credit score\\nPRODUCT: Debt collection\\n  - Attempts to collect debt not owed\\n  - Communication tactics\\n  - Electronic communications\\n  - False statements or representation\\n  - Threatened to contact someone or share information improperly\\n  - Took or threatened to take negative or legal action\\n  - Written notification about debt\\nPRODUCT: Debt or credit management\\n  - Charged upfront or unexpected fees\\n  - Confusing or misleading advertising or marketing\\n  - Confusing or missing disclosures\\n  - Didn't provide services promised\\n  - Problem with customer service\\n  - Unauthorized withdrawals or charges\\nPRODUCT: Money transfer, virtual currency, or money service\\n  - Confusing or missing disclosures\\n  - Fraud or scam\\n  - Lost or stolen money order\\n  - Managing, opening, or closing your mobile wallet account\\n  - Money was not available when promised\\n  - Other service problem\\n  - Other transaction problem\\n  - Problem with customer service\\n  - Trouble accessing funds in your mobile or digital wallet\\n  - Unauthorized transactions or other transaction problem\\n  - Unexpected or other fees\\n  - Wrong amount charged or received\\nPRODUCT: Mortgage\\n  - Applying for a mortgage or refinancing an existing mortgage\\n  - Closing on a mortgage\\n  - Improper use of your report\\n  - Incorrect information on your report\\n  - Problem with a company's investigation into an existing problem\\n  - Struggling to pay mortgage\\n  - Trouble during payment process\\nPRODUCT: Payday loan, title loan, personal loan, or advance loan\\n  - Can't contact lender or servicer\\n  - Charged fees or interest you didn't expect\\n  - Getting a line of credit\\n  - Getting the loan\\n  - Incorrect information on your report\\n  - Loan payment wasn't credited to your account\\n  - Problem when making payments\\n  - Problem with additional add-on products or services\\n  - Problem with the payoff process at the end of the loan\\n  - Received a loan you didn't apply for\\n  - Struggling to pay your loan\\n  - Vehicle was repossessed or sold the vehicle\\nPRODUCT: Prepaid card\\n  - Problem getting a card or closing an account\\n  - Problem with a purchase or transfer\\n  - Trouble using the card\\n  - Unexpected or other fees\\nPRODUCT: Student loan\\n  - Dealing with your lender or servicer\\n  - Incorrect information on your report\\n  - Struggling to repay your loan\\nPRODUCT: Vehicle loan or lease\\n  - Getting a loan or lease\\n  - Improper use of your report\\n  - Incorrect information on your report\\n  - Managing the loan or lease\\n  - Problem with a company's investigation into an existing problem\\n  - Problems at the end of the loan or lease\\n  - Repossession\\n  - Struggling to pay your loan\";\nconst SCHEMA = {\"type\": \"object\", \"title\": \"Result\", \"properties\": {\"product\": {\"enum\": [\"Checking or savings account\", \"Credit card\", \"Credit reporting or other personal consumer reports\", \"Debt collection\", \"Debt or credit management\", \"Money transfer, virtual currency, or money service\", \"Mortgage\", \"Payday loan, title loan, personal loan, or advance loan\", \"Prepaid card\", \"Student loan\", \"Vehicle loan or lease\"], \"title\": \"Product\"}, \"issue\": {\"type\": \"string\", \"title\": \"Issue\"}, \"predicted_outcome\": {\"enum\": [\"explanation_only\", \"non_monetary_relief\", \"monetary_relief\"], \"title\": \"Predicted Outcome\"}, \"needs_human_review\": {\"type\": \"boolean\", \"title\": \"Needs Human Review\"}, \"regulations_cited\": {\"type\": \"array\", \"title\": \"Regulations Cited\", \"items\": {\"type\": \"string\"}}, \"reply\": {\"type\": \"string\", \"title\": \"Reply\"}}, \"additionalProperties\": false, \"required\": [\"product\", \"issue\", \"predicted_outcome\", \"needs_human_review\", \"regulations_cited\", \"reply\"]};\nconst body = $input.first().json.body || {};\nconst narrative = String(body.narrative || '').trim();\nif (!narrative) throw new Error('Request must include \"narrative\" (the complaint text).');\nconst user = 'Company: ' + String(body.company || '') + '\\nState: ' + String(body.state || '') +\n  '\\n\\nComplaint:\\n' + narrative;\nreturn [{ json: {\n  complaint_id: String(body.complaint_id || ''),\n  started_at: Date.now(),\n  request: {\n    model: \"claude-haiku-5-5\",\n    max_tokens: 8000,\n    system: SYSTEM,\n    messages: [{ role: 'user', content: user }],\n    output_config: { format: { type: 'json_schema', schema: SCHEMA } },\n  },\n} }];\n"
      },
