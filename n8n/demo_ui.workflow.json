{
  "id": "ComplaintDemoUI01",
  "name": "Complaint Demo Page and Baseline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "app",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-01",
      "name": "Open page",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "webhookId": "complaint-demo-page"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Complaint Agent Demo</title>\n<style>\n  /* Colors taken from n8n's design system (@n8n/design-system theme.css):\n     neutral grays, pink brand accent, green success, gold warning, red danger. */\n  :root {\n    --bg: #f5f5f5;                          /* n8n canvas, light (neutral-125) */\n    --card: oklch(100% 0 0);                /* neutral-white */\n    --text: oklch(20.46% 0 0);              /* neutral-950 */\n    --muted: oklch(55.55% 0 0);             /* neutral-600 */\n    --line: oklch(92.19% 0 0);              /* neutral-200 */\n    --accent: oklch(68.08% .148 5.02);      /* pink-600 (brand) */\n    --accent-text: oklch(100% 0 0);\n    --soft: oklch(97.02% 0 0);              /* neutral-100 */\n    --ok-bg: oklch(96.24% .0434 156.74);    --ok-text: oklch(44.68% .1187 151.4);   /* green-100 / 800 */\n    --warn-bg: oklch(92.41% .0463 78.84);   --warn-text: oklch(40.5% .0793 72.23);  /* gold-100 / 800 */\n    --err-bg: oklch(93.65% .032 17.74);     --err-text: oklch(44.46% .1774 26.79);  /* red-100 / 800 */\n    --tag-bg: oklch(95.51% 0 0);            --tag-text: oklch(31.71% 0 0);          /* neutral-150 / 800 */\n    --mono: \"Geist Mono\", ui-monospace, \"Cascadia Mono\", Consolas, monospace;\n  }\n  @media (prefers-color-scheme: dark) {\n    :root:not([data-theme=\"light\"]) {\n      --bg: oklch(20.46% 0 0);              /* n8n canvas, dark (neutral-950) */\n      --card: #2b2b2b;                      /* neutral-850, like n8n's nodes */\n      --text: oklch(100% 0 0);\n      --muted: oklch(79.21% 0 0);           /* neutral-400 */\n      --line: #424242;                      /* neutral-750 */\n      --accent: oklch(78.07% .136 5.02);    /* pink-500 (brand) */\n      --accent-text: oklch(20.46% 0 0);\n      --soft: oklch(26.86% 0 0);            /* neutral-900 */\n      --ok-bg: oklch(26.54% .0651 152.77);  --ok-text: oklch(87.04% .149 154.62);   /* green-950 / 300 */\n      --warn-bg: oklch(24.57% .0436 73.41); --warn-text: oklch(84.14% .0975 76.95); /* gold-900 / 300 */\n      --err-bg: oklch(25.75% .0918 25.84);  --err-text: oklch(80.53% .1109 19.78);  /* red-950 / 300 */\n      --tag-bg: oklch(31.71% 0 0);          --tag-text: oklch(95.51% 0 0);          /* neutral-800 / 150 */\n    }\n  }\n  :root[data-theme=\"dark\"] {\n    --bg: oklch(20.46% 0 0); --card: #2b2b2b; --text: oklch(100% 0 0); --muted: oklch(79.21% 0 0);\n    --line: #424242; --accent: oklch(78.07% .136 5.02); --accent-text: oklch(20.46% 0 0);\n    --soft: oklch(26.86% 0 0);\n    --ok-bg: oklch(26.54% .0651 152.77);  --ok-text: oklch(87.04% .149 154.62);\n    --warn-bg: oklch(24.57% .0436 73.41); --warn-text: oklch(84.14% .0975 76.95);\n    --err-bg: oklch(25.75% .0918 25.84);  --err-text: oklch(80.53% .1109 19.78);\n    --tag-bg: oklch(31.71% 0 0);          --tag-text: oklch(95.51% 0 0);\n  }\n  * { box-sizing: border-box; }\n  body { margin: 0; background: var(--bg); color: var(--text);\n         font: 16px/1.5 \"Segoe UI\", system-ui, -apple-system, sans-serif; }\n  .wrap { max-width: 1280px; margin: 0 auto; padding: 20px 16px 48px; }\n  header { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }\n  h1 { font-size: 24px; margin: 0; }\n  .sub { color: var(--muted); margin: 2px 0 0; font-size: 14px; }\n  .controls { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }\n  .switch { display: flex; align-items: center; gap: 8px; cursor: pointer; user-select: none; font-size: 14px; }\n  .switch input { width: 18px; height: 18px; accent-color: var(--accent); }\n  .ghost { background: transparent; color: var(--text); border: 1px solid var(--line); border-radius: 8px;\n           padding: 6px 10px; cursor: pointer; font: inherit; font-size: 14px; }\n  .card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 18px; }\n  form.card { margin-top: 16px; display: grid; gap: 12px; }\n  .row { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 12px; }\n  label { display: grid; gap: 4px; font-size: 13px; color: var(--muted); font-weight: 600; }\n  input[type=text], select, textarea { font: inherit; color: var(--text); background: var(--bg);\n           border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; width: 100%; }\n  textarea { min-height: 150px; resize: vertical; }\n  .actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }\n  button.primary { background: var(--accent); color: var(--accent-text); border: 0; border-radius: 8px;\n           padding: 10px 22px; font: inherit; font-weight: 600; cursor: pointer; }\n  button.primary:disabled { opacity: .55; cursor: default; }\n  .hint { font-size: 14px; color: var(--muted); }\n  .hint.demo { color: var(--warn-text); background: var(--warn-bg); padding: 6px 10px; border-radius: 8px; }\n  .truth { font-size: 14px; background: var(--soft); border-radius: 8px; padding: 8px 12px; display: none; }\n  .truth b { font-weight: 600; }\n  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px; align-items: start; }\n  .col h2 { font-size: 18px; margin: 0; }\n  .col .what { color: var(--muted); font-size: 13px; margin: 2px 0 14px; }\n  .state { color: var(--muted); padding: 24px 0; text-align: center; }\n  .timer { font: 600 32px/1 var(--mono); color: var(--text); margin-bottom: 8px; }\n  .steps { list-style: none; padding: 0; margin: 12px auto 0; display: inline-block; text-align: left; font-size: 14px; }\n  .steps li::before { content: \"○ \"; color: var(--muted); }\n  .error { background: var(--err-bg); color: var(--err-text); border-radius: 8px; padding: 10px 12px; font-size: 14px; }\n  .badge { display: inline-block; font-weight: 700; border-radius: 999px; padding: 4px 12px; font-size: 14px; }\n  .badge.ok { background: var(--ok-bg); color: var(--ok-text); }\n  .badge.warn { background: var(--warn-bg); color: var(--warn-text); }\n  .reasons { margin: 8px 0 0; padding-left: 18px; font-size: 14px; }\n  dl { display: grid; grid-template-columns: 130px 1fr; gap: 6px 12px; margin: 16px 0; font-size: 14px; }\n  dt { color: var(--muted); font-weight: 600; }\n  dd { margin: 0; }\n  .tag { display: inline-block; background: var(--tag-bg); color: var(--tag-text); border-radius: 6px;\n         padding: 1px 8px; margin: 0 4px 4px 0; font-size: 13px; }\n  .tag.match { outline: 2px solid var(--ok-text); }\n  .tag.miss { outline: 2px solid var(--err-text); }\n  h3 { font-size: 14px; margin: 16px 0 6px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }\n  .reply { background: var(--soft); border-radius: 8px; padding: 12px; white-space: pre-wrap; font-size: 14px; }\n  .reply-head { display: flex; align-items: center; justify-content: space-between; }\n  ol.trace { margin: 0; padding-left: 20px; font-size: 14px; }\n  ol.trace li { margin: 2px 0; }\n  details { font-size: 14px; margin-top: 8px; }\n  summary { cursor: pointer; color: var(--muted); }\n  .foot { margin-top: 14px; font-size: 13px; color: var(--muted); border-top: 1px solid var(--line); padding-top: 10px; }\n  @media (max-width: 860px) { .cols { grid-template-columns: 1fr; } .row { grid-template-columns: 1fr; } }\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <header>\n    <div>\n      <h1>Complaint Triage and Resolution Agent</h1>\n      <p class=\"sub\">The same complaint goes to a one-prompt baseline and to the multi-agent workflow.</p>\n    </div>\n    <div class=\"controls\">\n      <label class=\"switch\" title=\"Send the agent request to n8n's test address so the canvas animates\">\n        <input type=\"checkbox\" id=\"demo\"> Demo mode (watch the canvas)\n      </label>\n      <button class=\"ghost\" id=\"theme\" type=\"button\">Theme</button>\n    </div>\n  </header>\n\n  <form class=\"card\" id=\"form\">\n    <div class=\"row\">\n      <label>Example complaint\n        <select id=\"example\"><option value=\"\">Write your own…</option></select>\n      </label>\n      <label>Company <input type=\"text\" id=\"company\" placeholder=\"e.g. WELLS FARGO &amp; COMPANY\"></label>\n      <label>State <input type=\"text\" id=\"state\" placeholder=\"e.g. CA\" maxlength=\"20\"></label>\n    </div>\n    <label>Complaint text\n      <textarea id=\"narrative\" placeholder=\"Describe the problem as the consumer would.\" required></textarea>\n    </label>\n    <div class=\"truth\" id=\"truth\"></div>\n    <div class=\"actions\">\n      <button class=\"primary\" id=\"submit\" type=\"submit\">Submit to both</button>\n      <span class=\"hint\" id=\"hint\">Each submission makes real Claude calls (about one cent).</span>\n    </div>\n  </form>\n\n  <div class=\"cols\">\n    <section class=\"card col\">\n      <h2>Baseline</h2>\n      <p class=\"what\">One Claude call. No tools, no review, no rules.</p>\n      <div id=\"out-baseline\"><div class=\"state\">Waiting for a complaint.</div></div>\n    </section>\n    <section class=\"card col\">\n      <h2>Agent</h2>\n      <p class=\"what\">Triage agent → resolution agent with tools → compliance critic → routing rules.</p>\n      <div id=\"out-agent\"><div class=\"state\">Waiting for a complaint.</div></div>\n    </section>\n  </div>\n</div>\n\n<script>\nconst EXAMPLES = [{\"label\": \"Fraud: $7,500 branch withdrawal (older consumer)\", \"complaint_id\": \"8018321\", \"company\": \"WELLS FARGO & COMPANY\", \"state\": \"CA\", \"narrative\": \"ON XX/XX/22 i had a withdrawal made from my account for {$7500.00}, The bank statement shows this withdrawal was made at a branch ( Wells Fargo ). When I received the statement & found this transaction I called the bank to report theft fraud immediately, I did not withdraw this money from my account Im very methodical pay my bills by check & us mail. I believe my information was hacked thru my XXXX I had a strange interaction with my computer & mobile phone I reported this to my bank & filed a report & claim. I never heard from Wells Fargo this has been very frustrating I continue to get the run around & stone walled?? I dont understand why no investigation no police involved nothing was done to return my money nor offered an explanation. Im writing you because I was just informed to report to your organization & several others to assist me with this issue.\", \"product\": \"Checking or savings account\", \"issue\": \"Managing an account\", \"outcome\": \"Closed with explanation\", \"tags\": \"Older American\"}, {\"label\": \"Credit report: accounts that are not mine\", \"complaint_id\": \"7552447\", \"company\": \"EQUIFAX, INC.\", \"state\": \"GA\", \"narrative\": \"I've diligently pursued resolutions for the inclusion of these accounts on my credit report, which are entirely unrelated to me. Unfortunately, my multiple dispute submissions have not led to the removal of these erroneous accounts from my credit history. In addition, I've taken the initiative to file numerous reports with the FTC regarding these accounts, which do not have any rightful connection to me. \\n\\nAccount Name : XXXX XXXX Account Number : XXXX Account Name : XXXX Account Number : XXXX Account Name : XXXX Account Number : XXXX Account Name :\", \"product\": \"Credit reporting or other personal consumer reports\", \"issue\": \"Incorrect information on your report\", \"outcome\": \"Closed with non-monetary relief\", \"tags\": \"\"}, {\"label\": \"Debt collector calling several times a day\", \"complaint_id\": \"7673803\", \"company\": \"Harley Davidson Financial Services Inc\", \"state\": \"FL\", \"narrative\": \"This company contacts me several times a day and claims that they are allowed to call every day if they do not reach someone and also that they are allowed to call every three days after they speak to someone. I have asked them many times why they do not have to adhere to the Debt Collection rule and all they say is that their policy says they are allowed to do it and if I disagree I can have my lawyer contact them.\", \"product\": \"Debt collection\", \"issue\": \"Communication tactics\", \"outcome\": \"Closed with explanation\", \"tags\": \"\"}, {\"label\": \"Mortgage: escrow surplus not refunded\", \"complaint_id\": \"7776127\", \"company\": \"CITIZENS FINANCIAL GROUP, INC.\", \"state\": \"NM\", \"narrative\": \"I re-submitted a complaint on XX/XX/23 about Citizens Bank depositing escrow surplus funds that are due to be refunded to me. XXXX XXXX from Citizens Bank called me on this same date and left a message for me to call her back. Today, I have called her direct line, emailed her, and called customer service for her to call me back. I have yet to get a response. I am XXXX  to hear from her because Citizen 's Bank owes me over {$11000.00} that by law must be refunded to me. I want to know the status of repayment of this money. I want to know the status immediately!\", \"product\": \"Mortgage\", \"issue\": \"Trouble during payment process\", \"outcome\": \"Closed with explanation\", \"tags\": \"\"}, {\"label\": \"Card scam, servicemember\", \"complaint_id\": \"7711475\", \"company\": \"JPMORGAN CHASE & CO.\", \"state\": \"CA\", \"narrative\": \"Chase place the amount of for {$3500.00} back to my account and said it was my responsibility when it is not they advised phone verification was done and this is because we were hacked and sent text messages we thought from chase and believed to be the cammers or fraudsters and was completed on XX/XX/. We confirmed that an over-the-phone verification was completed by text message to your phone number ending in XXXX. You are welcome to provide additional documentation for reconsideration of your fraud claim. XXXX\", \"product\": \"Credit card\", \"issue\": \"Problem with a purchase shown on your statement\", \"outcome\": \"Closed with monetary relief\", \"tags\": \"Servicemember\"}];\nconst OUTCOME_LABEL = {\n  explanation_only: \"Explanation only\",\n  non_monetary_relief: \"Non-monetary relief\",\n  monetary_relief: \"Monetary relief\",\n};\nconst TRUE_TO_OUTCOME = {\n  \"Closed with explanation\": \"explanation_only\",\n  \"Closed with non-monetary relief\": \"non_monetary_relief\",\n  \"Closed with monetary relief\": \"monetary_relief\",\n};\n\nconst $ = (id) => document.getElementById(id);\nconst base = new URL(\"/\", location.href);\nconst url = (path) => new URL(path, base).href;\n\n// Browser storage may be blocked on this page; it is only a convenience.\nconst store = {\n  get(k) { try { return localStorage.getItem(k); } catch { return null; } },\n  set(k, v) { try { localStorage.setItem(k, v); } catch {} },\n};\n\n// --- theme --------------------------------------------------------------\nfunction applyTheme(t) { if (t) document.documentElement.dataset.theme = t; }\napplyTheme(store.get(\"theme\"));\n$(\"theme\").onclick = () => {\n  const dark = document.documentElement.dataset.theme\n    ? document.documentElement.dataset.theme === \"dark\"\n    : matchMedia(\"(prefers-color-scheme: dark)\").matches;\n  const next = dark ? \"light\" : \"dark\";\n  applyTheme(next); store.set(\"theme\", next);\n};\n\n// --- demo mode ------------------------------------------------------------\n$(\"demo\").checked = store.get(\"demo\") === \"1\";\nfunction showHint() {\n  const h = $(\"hint\");\n  if ($(\"demo\").checked) {\n    h.className = \"hint demo\";\n    h.textContent = \"Demo mode: click “Execute workflow” on the n8n canvas first, then Submit. Repeat for each complaint.\";\n  } else {\n    h.className = \"hint\";\n    h.textContent = \"Each submission makes real Claude calls (about one cent).\";\n  }\n}\n$(\"demo\").onchange = () => { store.set(\"demo\", $(\"demo\").checked ? \"1\" : \"0\"); showHint(); };\nshowHint();\n\n// --- examples -------------------------------------------------------------\nEXAMPLES.forEach((ex, i) => {\n  const o = document.createElement(\"option\");\n  o.value = String(i); o.textContent = ex.label;\n  $(\"example\").appendChild(o);\n});\nlet current = null;   // the example loaded, while its text is unchanged\n$(\"example\").onchange = () => {\n  const ex = EXAMPLES[Number($(\"example\").value)];\n  current = ex || null;\n  $(\"company\").value = ex ? ex.company : \"\";\n  $(\"state\").value = ex ? ex.state : \"\";\n  $(\"narrative\").value = ex ? ex.narrative : \"\";\n  showTruth();\n};\n$(\"narrative\").oninput = () => {\n  if (current && $(\"narrative\").value !== current.narrative) { current = null; $(\"example\").value = \"\"; showTruth(); }\n};\nfunction showTruth() {\n  const t = $(\"truth\");\n  if (!current) { t.style.display = \"none\"; return; }\n  t.style.display = \"block\";\n  t.replaceChildren();\n  t.append(\"Real CFPB record: \");\n  const b = document.createElement(\"b\"); b.textContent = `${current.product} / ${current.issue}`;\n  t.append(b, \" — company \");\n  const o = document.createElement(\"b\"); o.textContent = current.outcome.toLowerCase();\n  t.append(o, current.tags ? ` — tags: ${current.tags}` : \"\");\n}\n\n// --- rendering helpers (model text is always inserted as text, never as HTML)\nfunction el(tag, attrs = {}, ...kids) {\n  const n = document.createElement(tag);\n  for (const [k, v] of Object.entries(attrs)) {\n    if (k === \"class\") n.className = v; else if (k === \"text\") n.textContent = v; else n.setAttribute(k, v);\n  }\n  for (const k of kids) if (k != null) n.append(k);\n  return n;\n}\nfunction tags(list, cls = () => \"\") {\n  const d = el(\"dd\");\n  if (!list || !list.length) { d.append(\"—\"); return d; }\n  list.forEach((t) => d.append(el(\"span\", { class: \"tag \" + cls(t), text: t })));\n  return d;\n}\nfunction waiting(target, steps) {\n  const start = Date.now();\n  const timer = el(\"div\", { class: \"timer\", text: \"0.0 s\" });\n  const box = el(\"div\", { class: \"state\" }, timer, el(\"div\", { text: \"Working…\" }));\n  if (steps) {\n    const ul = el(\"ul\", { class: \"steps\" });\n    steps.forEach((s) => ul.append(el(\"li\", { text: s })));\n    box.append(ul);\n  }\n  target.replaceChildren(box);\n  const id = setInterval(() => { timer.textContent = ((Date.now() - start) / 1000).toFixed(1) + \" s\"; }, 100);\n  return () => clearInterval(id);\n}\nfunction showError(target, msg) { target.replaceChildren(el(\"div\", { class: \"error\", text: msg })); }\n\nfunction render(target, r, kind) {\n  const out = [];\n  const review = r.needs_human_review;\n  out.push(el(\"span\", { class: \"badge \" + (review ? \"warn\" : \"ok\"),\n    text: review ? \"Needs human review\" : \"Ready to send\" }));\n  if (kind === \"agent\" && r.review_reasons && r.review_reasons.length) {\n    const ul = el(\"ul\", { class: \"reasons\" });\n    r.review_reasons.forEach((x) => ul.append(el(\"li\", { text: x })));\n    out.push(ul);\n  }\n  if (kind === \"baseline\") {\n    out.push(el(\"p\", { class: \"hint\", text: \"The baseline only answers yes or no here; it gives no reason.\" }));\n  }\n\n  const truthOutcome = current ? TRUE_TO_OUTCOME[current.outcome] : null;\n  const mark = (ok) => (current ? (ok ? \"match\" : \"miss\") : \"\");\n  const dl = el(\"dl\");\n  dl.append(el(\"dt\", { text: \"Product\" }), tags([r.product], (t) => mark(t === current?.product)));\n  dl.append(el(\"dt\", { text: \"Issue\" }), tags([r.issue], (t) => mark(t === current?.issue)));\n  if (kind === \"agent\") {\n    dl.append(el(\"dt\", { text: \"Urgency\" }), tags([r.urgency]));\n    dl.append(el(\"dt\", { text: \"Risk flags\" }), tags(r.risk_flags));\n  }\n  dl.append(el(\"dt\", { text: \"Predicted outcome\" }),\n    tags([OUTCOME_LABEL[r.predicted_outcome] || r.predicted_outcome],\n         () => mark(r.predicted_outcome === truthOutcome)));\n  dl.append(el(\"dt\", { text: \"Laws cited\" }), tags(r.regulations_cited));\n  out.push(dl);\n  if (current) out.push(el(\"p\", { class: \"hint\", text: \"Green outline: matches the real CFPB record. Red: does not.\" }));\n\n  if (kind === \"agent\" && r.outcome_reasoning) {\n    out.push(el(\"h3\", { text: \"Why this outcome\" }), el(\"p\", { style: \"margin:0;font-size:14px\", text: r.outcome_reasoning }));\n  }\n\n  const copy = el(\"button\", { class: \"ghost\", type: \"button\", text: \"Copy\" });\n  copy.onclick = async () => {\n    try { await navigator.clipboard.writeText(r.reply); copy.textContent = \"Copied\"; }\n    catch { copy.textContent = \"Select and copy\"; }\n    setTimeout(() => (copy.textContent = \"Copy\"), 1500);\n  };\n  out.push(el(\"div\", { class: \"reply-head\" }, el(\"h3\", { text: \"Drafted reply\" }), copy));\n  out.push(el(\"div\", { class: \"reply\", text: r.reply }));\n\n  if (kind === \"agent\" && r.trace) {\n    const ol = el(\"ol\", { class: \"trace\" });\n    r.trace.forEach((t) => ol.append(el(\"li\", { text: t })));\n    out.push(el(\"h3\", { text: \"What the agent did\" }), ol);\n    if (r.critic_suggestions && r.critic_suggestions.length) {\n      const ul = el(\"ul\", { class: \"reasons\" });\n      r.critic_suggestions.forEach((s) => ul.append(el(\"li\", { text: s })));\n      out.push(el(\"details\", {}, el(\"summary\", { text: `Critic's minor suggestions (${r.critic_suggestions.length}), not blocking` }), ul));\n    }\n  }\n\n  const foot = kind === \"agent\"\n    ? `${r.seconds} s · ${r.revisions} revision${r.revisions === 1 ? \"\" : \"s\"} · ${r.agent_runs} agent runs`\n    : `${r.seconds} s · 1 Claude call · ${r.input_tokens + r.output_tokens} tokens`;\n  out.push(el(\"div\", { class: \"foot\", text: foot }));\n  target.replaceChildren(...out);\n}\n\n// --- submit -----------------------------------------------------------------\nasync function call(path, payload) {\n  let res;\n  try {\n    res = await fetch(url(path), {\n      method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: JSON.stringify(payload),\n    });\n  } catch {\n    throw new Error(\"Could not reach n8n. Is it running?\" +\n      (path.includes(\"webhook-test\") ? \" In demo mode, click “Execute workflow” on the canvas first.\" : \"\"));\n  }\n  const text = await res.text();\n  if (res.status === 404 && path.includes(\"webhook-test\")) {\n    throw new Error(\"n8n is not listening yet. Click “Execute workflow” on the canvas, then Submit again.\");\n  }\n  let data = null;\n  try { data = JSON.parse(text); } catch {}\n  if (!res.ok || !data || data.message === \"Error in workflow\") {\n    throw new Error(`The workflow failed (HTTP ${res.status}). Open the Executions tab in n8n to see why.`);\n  }\n  return data;\n}\n\n$(\"form\").onsubmit = async (e) => {\n  e.preventDefault();\n  const payload = {\n    complaint_id: current ? current.complaint_id : \"demo-\" + Date.now(),\n    company: $(\"company\").value.trim() || \"Unknown\",\n    state: $(\"state\").value.trim() || \"Unknown\",\n    narrative: $(\"narrative\").value.trim(),\n  };\n  if (!payload.narrative) return;\n  $(\"submit\").disabled = true;\n\n  const agentPath = $(\"demo\").checked ? \"webhook-test/complaint\" : \"webhook/complaint\";\n  const stopB = waiting($(\"out-baseline\"));\n  const stopA = waiting($(\"out-agent\"),\n    [\"Triage\", \"Research (regulations, company history)\", \"Draft reply\", \"Compliance review\", \"Routing\"]);\n\n  const jobs = [\n    call(\"webhook/baseline\", payload)\n      .then((r) => render($(\"out-baseline\"), r, \"baseline\"))\n      .catch((err) => showError($(\"out-baseline\"), err.message))\n      .finally(stopB),\n    call(agentPath, payload)\n      .then((r) => render($(\"out-agent\"), r, \"agent\"))\n      .catch((err) => showError($(\"out-agent\"), err.message))\n      .finally(stopA),\n  ];\n  await Promise.allSettled(jobs);\n  $(\"submit\").disabled = false;\n};\n</script>\n</body>\n</html>\n",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              },
              {
                "name": "Cache-Control",
